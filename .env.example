# ==================================
# Application Configuration
# ==================================

# Application name
APP_NAME=AI Agent Automation Platform


# Environment mode
# Options:
# development
# production
APP_ENV=development


# Debug mode
# true = development
# false = production
DEBUG=true



# ==================================
# Ollama LLM Configuration
# ==================================

# Local Ollama server address
OLLAMA_HOST=http://localhost:11434


# Local model used by the AI agent
# Examples:
# tinyllama
# llama3.2
# mistral
OLLAMA_MODEL=tinyllama