# LLM provider configuration
# This will store the API key for the language model provider.
LLM_API_KEY=your_api_key_here

# Model name used by the AI agent.
# Example: gpt-4.1-mini, gpt-4o-mini, etc.
LLM_MODEL=tinyllama

# Application settings
# Controls whether the API runs in development or production mode.
APP_ENV=development

