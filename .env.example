APP_NAME=AI Agent Automation
APP_ENV=development
DEBUG=true

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# When true the agent falls back to a local deterministic
# model when Ollama is offline (keeps tests/UI working).
ENABLE_OFFLINE_FALLBACK=true

DATABASE_URL=sqlite+aiosqlite:///./ai_agent.db

# Optional API key authentication.
# All /api/v1 endpoints require X-API-Key when set.
API_KEY=

# RAG vector store configuration
VECTOR_STORE_PATH=data/chroma
EMBEDDING_DIMENSION=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=3
